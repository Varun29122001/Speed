<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <!-- Download speed indicator -->
    <ImageView
        android:id="@+id/icon_status"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@android:drawable/stat_sys_download_done"
        android:tint="#1A1C1E"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/text_speed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:text="@string/notification_speed_default"
        android:textColor="#1A1C1E"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Wi-Fi data usage -->
    <ImageView
        android:id="@+id/icon_wifi"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/ic_wifi"
        android:tint="#1A1C1E"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/text_wifi_usage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:textColor="#1A1C1E"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Separator -->
    <TextView
        android:id="@+id/text_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:text="|"
        android:textColor="#1A1C1E"
        android:textSize="15sp"
        android:alpha="0.4" />

    <!-- Mobile data usage -->
    <ImageView
        android:id="@+id/icon_mobile"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/ic_mobile_data"
        android:tint="#1A1C1E"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/text_mobile_usage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:textColor="#1A1C1E"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
