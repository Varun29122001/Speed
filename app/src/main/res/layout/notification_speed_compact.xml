<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <!-- Download speed icon + text -->
    <ImageView
        android:id="@+id/icon_download"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@android:drawable/stat_sys_download_done"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/text_download_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:text="@string/notification_speed_default"
        android:textColor="#1A1C1E"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Upload speed icon (flipped download icon) + text -->
    <ImageView
        android:id="@+id/icon_upload"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="10dp"
        android:src="@drawable/ic_upload"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/text_upload_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:text="@string/notification_speed_default"
        android:textColor="#1A1C1E"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Spacer to push data usage to the right -->
    <TextView
        android:id="@+id/text_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Wi-Fi data usage -->
    <ImageView
        android:id="@+id/icon_wifi"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/ic_wifi"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/text_wifi_usage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:textColor="#1A1C1E"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Separator -->
    <TextView
        android:id="@+id/text_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:text="|"
        android:textColor="#1A1C1E"
        android:textSize="12sp"
        android:alpha="0.4" />

    <!-- Mobile data usage -->
    <ImageView
        android:id="@+id/icon_mobile"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/ic_mobile_data"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/text_mobile_usage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:textColor="#1A1C1E"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
